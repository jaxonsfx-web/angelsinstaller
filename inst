step() { printf '\n%s›%s %s\n' "$WHITE" "$RESET" "$1"; }
complete() { printf '%s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
fail() { printf '%s✗%s %s\n' "$RED" "$RESET" "$1" >&2; }
# Spinner only runs when connected to a terminal. Command logs remain available on failure.
animated() {
  local label="$1"; shift
  local log="$tmp/task.log" status=0 pid frame
  : > "$log"
  "$@" > "$log" 2>&1 & pid=$!
  if [[ -t 1 ]]; then
    local frames=('|' '/' '-' '\\') i=0
    while kill -0 "$pid" 2>/dev/null; do
      frame="${frames[i % 4]}"; i=$((i+1))
      printf '\r\033[K%s[%s]%s %s' "$WHITE" "$frame" "$RESET" "$label"
      sleep 0.12
    done
  fi
  wait "$pid" || status=$?
  if [[ -t 1 ]]; then printf '\r\033[K'; fi
  if (( status != 0 )); then fail "$label"; cat "$log" >&2; return "$status"; fi
  complete "$label"
}

BACKUP_ROOT="$HOME/Documents/Angels Settings Backup"
DATA_DIR="$HOME/Library/Application Support/Angels"
PREF_FILE="$HOME/Library/Preferences/com.angels.launcher.plist"
restore_settings() {
  [[ -d "$BACKUP_ROOT" ]] || return 0
  local folder latest="" ans
  for folder in "$BACKUP_ROOT"/20*; do
    [[ -d "$folder" && ! -L "$folder" ]] && latest="$folder"
  done
  [[ -n "$latest" ]] || return 0
  printf '\nPrevious Angels settings backup found in Documents.\n%s\n' "$latest"
  [[ -t 0 ]] || { echo "Restore skipped (requires interactive confirmation)."; return 0; }
  read -r -p 'Use these previous settings? [y/N]: ' ans
  case "$ans" in y|Y|yes|YES) ;;
    *) echo "Keeping backup for later."; return 0 ;;
  esac
  if [[ -d "$latest/data/Angels" && ! -L "$latest/data/Angels" ]]; then
    if [[ -e "$DATA_DIR" ]]; then echo "Existing Angels data found; not overwriting."; else
      mkdir -p "$(dirname "$DATA_DIR")"
      ditto "$latest/data/Angels" "$DATA_DIR"
      echo "Restored Angels data."
    fi
  fi
  if [[ -f "$latest/prefs/com.angels.launcher.plist" && ! -L "$latest/prefs/com.angels.launcher.plist" ]]; then
    if [[ -e "$PREF_FILE" ]]; then echo "Existing Angels preferences found; not overwriting."; else
      mkdir -p "$(dirname "$PREF_FILE")"
      cp -p "$latest/prefs/com.angels.launcher.plist" "$PREF_FILE"
      echo "Restored Angels preferences."
    fi
  fi
}

