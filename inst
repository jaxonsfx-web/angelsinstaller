[[ "$(uname -s)" == "Darwin" ]] || { fail "Angels requires macOS."; exit 1; }
[[ "$(uname -m)" == "arm64" ]] || { fail "This release supports Apple Silicon Macs only."; exit 1; }
for cmd in curl shasum python3 sed; do command -v "$cmd" >/dev/null || { fail "Missing required command: $cmd"; exit 1; }; done
tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
repo='jaxonsfx-web/angelsinstaller'
if [[ -d /Applications/Angels.app || -d "$HOME/Applications/Angels.app" ]]; then
 echo 'Angels is already installed. Reinstall the latest released version?'
 [[ -t 0 ]] || { echo 'Confirmation required to reinstall.'; exit 1; }
 read -r -p 'Reinstall Angels? [y/N]: ' answer
 case "$answer" in y|Y|yes|YES) ;; *) echo 'Reinstall cancelled.'; exit 0;; esac
fi
printf '\n› Downloading Angels\n'
progress_start
if ! curl -fsSL --retry 2 -H 'Cache-Control: no-cache' "https://api.github.com/repos/$repo/releases?per_page=100&cache=$(date +%s)" -o "$tmp/latest.json" 2>"$tmp/error.log"; then
  fail_and_exit 'Could not check published releases.'
fi
python3 - "$tmp/latest.json" "$tmp/links" >"$tmp/error.log" 2>&1 <<'PY' || fail_and_exit 'Could not select a published Angels release.'
import json, sys
from urllib.parse import urlparse
releases = json.load(open(sys.argv[1]))
if not isinstance(releases, list):
    raise SystemExit('Unexpected GitHub release response.')
# Pick the highest numbered published release with matching checksum.
import re
candidates = []
for release in releases:
    if release.get('draft') or release.get('prerelease'):
        continue
    assets = release.get('assets', [])
    for asset in assets:
        match = re.fullmatch(r'Angels-arm64-(\d+\.\d+\.\d+)\.pkg', asset.get('name', ''))
        if not match:
            continue
        sha = next((entry for entry in assets if entry.get('name') == asset['name'] + '.sha256'), None)
        if sha:
            candidates.append((tuple(int(x) for x in match.group(1).split('.')), asset, sha, release))
if not candidates:
    raise SystemExit('No published Angels macOS release includes both a .pkg and checksum.')
version, pkg, checksum, release = max(candidates, key=lambda entry: entry[0])
print('Latest published Angels macOS: ' + '.'.join(str(x) for x in version))
print('Release: ' + release.get('html_url', 'unknown'))
for asset in (pkg, checksum):
    url = urlparse(asset['browser_download_url'])
    if url.scheme != 'https' or url.hostname != 'github.com' or not url.path.startswith('/jaxonsfx-web/angelsinstaller/releases/download/'):
        raise SystemExit('Unexpected download location; installation cancelled.')
with open(sys.argv[2], 'w') as out:
    out.write(pkg['browser_download_url'] + '\n' + checksum['browser_download_url'] + '\n' + pkg['name'] + '\n')
PY
pkg_url="$(sed -n '1p' "$tmp/links")"
checksum_url="$(sed -n '2p' "$tmp/links")"
pkg_name="$(sed -n '3p' "$tmp/links")"
if ! curl -fsSL --retry 2 "$pkg_url" -o "$tmp/$pkg_name" 2>"$tmp/error.log"; then
  fail_and_exit 'Could not download Angels.'
fi
if ! curl -fsSL --retry 2 "$checksum_url" -o "$tmp/$pkg_name.sha256" 2>"$tmp/error.log"; then
  fail_and_exit 'Could not download the verification checksum.'
fi
if ! (cd "$tmp" && shasum -a 256 -c "$pkg_name.sha256") >"$tmp/error.log" 2>&1; then
  fail_and_exit 'Downloaded package failed integrity verification.'
fi
progress_stop
printf '%s✓%s Completed Download\n' "$GREEN" "$RESET"

# Administrator authentication can prompt interactively here.
if ! sudo /usr/sbin/installer -pkg "$tmp/$pkg_name" -target / >"$tmp/error.log" 2>&1; then
  fail "Installation failed."
  cat "$tmp/error.log" >&2
  exit 1
fi
printf '%s✓%s Angels installed successfully.\n' "$GREEN" "$RESET"
restore_settings
