step() { printf '\n%s›%s %s\n' "$WHITE" "$RESET" "$1"; }
complete() { printf '%s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
fail() { printf '%s✗%s %s\n' "$RED" "$RESET" "$1" >&2; }
# Spinner only runs when connected to a terminal. Command logs remain available on failure.
animated() {
  local label="$1"; shift
  local log="$tmp/task.log" status=0 pid frame
  : > "$log"
  "$@" > "$log" 2>&1 & pid=$!
  if [[ -t 1 ]]; then
    local frames=('|' '/' '-' '\\') i=0
    while kill -0 "$pid" 2>/dev/null; do
      frame="${frames[i % 4]}"; i=$((i+1))
      printf '\r\033[K%s[%s]%s %s' "$WHITE" "$frame" "$RESET" "$label"
      sleep 0.12
    done
  fi
  wait "$pid" || status=$?
  if [[ -t 1 ]]; then printf '\r\033[K'; fi
  if (( status != 0 )); then fail "$label"; cat "$log" >&2; return "$status"; fi
  complete "$label"
}

