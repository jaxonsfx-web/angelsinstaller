 echo 'Angels is already installed. Reinstall the latest released version?'
 [[ -t 0 ]] || { echo 'Confirmation required to reinstall.'; exit 1; }
 read -r -p 'Reinstall Angels? [y/N]: ' answer
 case "$answer" in y|Y|yes|YES) ;; *) echo 'Reinstall cancelled.'; exit 0;; esac
fi
step "Checking for the latest release"
animated 'Fetching release information' curl -fsSL --retry 2 "https://api.github.com/repos/$repo/releases/latest" -o "$tmp/latest.json"
python3 - "$tmp/latest.json" "$tmp/links" <<'PY'
import json, sys
from urllib.parse import urlparse
r = json.load(open(sys.argv[1]))
assets = r.get('assets', [])
pkg = next((a for a in assets if a['name'].startswith('Angels-arm64-') and a['name'].endswith('.pkg')), None)
if not pkg:
    raise SystemExit('No published Angels Apple Silicon installer is available yet.')
checksum = next((a for a in assets if a['name'] == pkg['name'] + '.sha256'), None)
if not checksum:
    raise SystemExit('The release has no matching checksum; installation cancelled.')
for asset in (pkg, checksum):
    url = urlparse(asset['browser_download_url'])
    if url.scheme != 'https' or url.hostname != 'github.com' or not url.path.startswith('/jaxonsfx-web/angelsinstaller/releases/download/'):
        raise SystemExit('Unexpected download location; installation cancelled.')
with open(sys.argv[2], 'w') as out:
    out.write(pkg['browser_download_url'] + '\n' + checksum['browser_download_url'] + '\n' + pkg['name'] + '\n')
PY
pkg_url="$(sed -n '1p' "$tmp/links")"
checksum_url="$(sed -n '2p' "$tmp/links")"
pkg_name="$(sed -n '3p' "$tmp/links")"
step "Downloading Angels"
animated 'Downloading application package' curl -fSL --retry 2 "$pkg_url" -o "$tmp/$pkg_name"
animated 'Downloading verification checksum' curl -fSL --retry 2 "$checksum_url" -o "$tmp/$pkg_name.sha256"
step 'Checking package integrity'
animated 'Verifying SHA-256 checksum' bash -c 'cd "$1" && shasum -a 256 -c "$2"' _ "$tmp" "$pkg_name.sha256"
step 'Installing to /Applications'
printf '%s\n' "${GREY}macOS may request your administrator password.${RESET}"
animated 'Installing Angels.app' sudo /usr/sbin/installer -pkg "$tmp/$pkg_name" -target /
printf '\n%s✓ Angels installation complete.%s\n' "$GREEN" "$RESET"
restore_settings
printf 'Open Angels from the Applications folder.\n\n'
