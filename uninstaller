BACKUP_ROOT="$HOME/Documents/Angels Settings Backup"
DATA_DIR="$HOME/Library/Application Support/Angels"
PREF_FILE="$HOME/Library/Preferences/com.angels.launcher.plist"
backup_settings() {
  mkdir -p "$BACKUP_ROOT"
  local stage dest
  stage="$(mktemp -d "$BACKUP_ROOT/.pending.XXXXXX")"
  if [[ -d "$DATA_DIR" && ! -L "$DATA_DIR" ]]; then mkdir -p "$stage/data"; ditto "$DATA_DIR" "$stage/data/Angels"; fi
  if [[ -f "$PREF_FILE" && ! -L "$PREF_FILE" ]]; then mkdir -p "$stage/prefs"; cp -p "$PREF_FILE" "$stage/prefs/"; fi
  if [[ ! -e "$stage/data/Angels" && ! -f "$stage/prefs/com.angels.launcher.plist" ]]; then
    rmdir "$stage/data" "$stage/prefs" "$stage" 2>/dev/null || true
    echo "No supported Angels settings found; nothing was saved."
    return 0
  fi
  dest="$BACKUP_ROOT/$(date +%Y%m%d-%H%M%S)-$"
  mv "$stage" "$dest"
  printf 'Settings saved: %s\n' "$dest"
}
banner()
if [[ "$(uname -s)" != "Darwin" ]]; then echo 'This uninstaller is for macOS only.' >&2; exit 1; fi
found=()
for candidate in "/Applications/Angels.app" "$HOME/Applications/Angels.app"; do
  if [[ -d "$candidate" && ! -L "$candidate" ]]; then found+=("$candidate"); fi
done
if (( ${#found[@]} == 0 )); then
  echo 'Angels.app was not found in the Applications folders. Nothing to uninstall.'
  exit 0
fi
printf 'The following Angels app bundle(s) will be removed:\n'
for candidate in "${found[@]}"; do printf '  • %s\n' "$candidate"; done
printf '\n%sRoblox, its settings, and your personal files will not be touched.%s\n' "$DIM" "$RESET"
if [[ ! -t 0 ]]; then echo 'Interactive confirmation required; nothing removed.' >&2; exit 1; fi
printf '\nYou may have Angels preferences you want to keep. Save a backup to Documents before uninstalling?\n'
read -r -p 'Save settings? [Y/n]: ' save_answer
case "$save_answer" in n|N|no|NO) echo 'Skipping backup.';; *) backup_settings || { echo 'Backup failed; uninstall cancelled.' >&2; exit 1; };; esac
read -r -p "Type UNINSTALL to confirm: " answer
if [[ "$answer" != 'UNINSTALL' ]]; then echo 'Cancelled. No changes made.'; exit 0; fi
# A PKG installed with sudo can own files even when /Applications itself is writable.
# Always use administrator privileges for the system Applications folder.
removed=0
failed=0
for candidate in "${found[@]}"; do
  [[ "$candidate" == '/Applications/Angels.app' || "$candidate" == "$HOME/Applications/Angels.app" ]] || exit 1
  [[ -d "$candidate" && ! -L "$candidate" ]] || { echo "Skipping changed path: $candidate" >&2; failed=1; continue; }
  if [[ "$candidate" == '/Applications/Angels.app' ]]; then
    echo 'Administrator permission is required to remove the system-installed Angels app.'
    if ! sudo /bin/rm -rf -- "$candidate"; then
      echo "Failed to remove $candidate" >&2
      failed=1
      continue
    fi
  else
    if ! /bin/rm -rf -- "$candidate"; then
      echo "Standard removal was denied; requesting administrator permission."
      if ! sudo /bin/rm -rf -- "$candidate"; then
        echo "Failed to remove $candidate" >&2
        failed=1
        continue
      fi
    fi
  fi
  if [[ -e "$candidate" ]]; then
    echo "Removal incomplete: $candidate still exists" >&2
    failed=1
  else
    echo "Removed $candidate"
    removed=$((removed + 1))
  fi
done
if (( failed != 0 )); then
  echo 'Angels could not be completely removed. Check the errors above.' >&2
  exit 1
fi
printf '\\n%s✓ Angels uninstalled.%s\\n' "$GREEN" "$RESET"
echo 'Original preferences and cache remain untouched. Backups are stored in Documents.'
